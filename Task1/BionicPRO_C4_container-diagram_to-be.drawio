" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;exitX=0.5;exitY=0.7619;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7619;entryDx=0;entryDy=0;" source="seq-28" target="seq-27"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="1040" as="sourcePoint" /><mxPoint x="135.0" y="1040" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-54" value="20. POST /logout" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.8254;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8254;entryDx=0;entryDy=0;" source="seq-27" target="seq-28"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="1120" as="sourcePoint" /><mxPoint x="415.0" y="1120" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-55" value="21. POST /logout (refresh_token) — отзыв сессии в Keycloak" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.8571;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8571;entryDx=0;entryDy=0;" source="seq-28" target="seq-30"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="1160" as="sourcePoint" /><mxPoint x="975.0" y="1160" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-56" value="22. DEL sid" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.8889;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8889;entryDx=0;entryDy=0;" source="seq-28" target="seq-29"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="1200" as="sourcePoint" /><mxPoint x="695.0" y="1200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-57" value="23. 302 / + Set-Cookie: sid=; Max-Age=0" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;exitX=0.5;exitY=0.9206;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9206;entryDx=0;entryDy=0;" source="seq-28" target="seq-27"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="1240" as="sourcePoint" /><mxPoint x="135.0" y="1240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-58" value="&lt;b&gt;Инвариант:&lt;/b&gt; access-, refresh- и id-токены существуют только между BFF, Redis, Keycloak и API. Браузер и мобильное приложение видят только случайный session id." vertex="1" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#333333;"><mxGeometry x="1330" y="20" width="390" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>