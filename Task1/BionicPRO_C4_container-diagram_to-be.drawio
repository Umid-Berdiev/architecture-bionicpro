;fontColor=#B85450;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="task1-3" target="task1-6"><mxGeometry width="160" relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1100" y="632" /></Array></mxGeometry></mxCell></object><object placeholders="1" id="task1-21" c4Type="Relationship" c4Technology="OIDC" c4Description="SSO покупателей и сотрудников" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;strokeColor=#B85450;fontColor=#B85450;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="-s9W17W-NFw-Ta7AQgpa-19" target="task1-3"><mxGeometry width="160" relative="1" x="0.3" as="geometry" /></mxCell></object><object placeholders="1" id="task1-22" c4Type="Relationship" c4Technology="OIDC" c4Description="SSO сотрудников" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;strokeColor=#B85450;fontColor=#B85450;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="-s9W17W-NFw-Ta7AQgpa-16" target="task1-3"><mxGeometry width="160" relative="1" x="0.3" as="geometry" /></mxCell></object><mxCell id="task1-23" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color='#B85450'&gt;——&amp;gt;&lt;/font&gt; связи, добавленные в to-be&lt;br&gt;——&amp;gt; связи из as-is&lt;br&gt;серый блок — внешняя система страны присутствия&lt;br&gt;&lt;br&gt;&lt;b&gt;Ключевые решения&lt;/b&gt;&lt;br&gt;1. Один контур доступа на страну: Keycloak, его БД, BFF и Redis развёрнуты в стране; учётные данные берутся из местного каталога (федерация без импорта).&lt;br&gt;2. Токены IdP никогда не покидают серверную часть: клиент получает только opaque session id в HttpOnly-cookie (паттерн BFF).&lt;br&gt;3. Новые страны и внешние IdP подключаются через Identity Brokering Keycloak, без изменения приложений." vertex="1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;"><mxGeometry x="1520" y="740" width="230" height="270" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
