l)" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.3889;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3889;entryDx=0;entryDy=0;" source="seq-28" target="seq-30"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="570" as="sourcePoint" /><mxPoint x="975.0" y="570" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-42" value="9. access_token (JWT, ~5 мин), refresh_token, id_token" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;exitX=0.5;exitY=0.4127;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4127;entryDx=0;entryDy=0;" source="seq-30" target="seq-28"><mxGeometry relative="1" as="geometry"><mxPoint x="975.0" y="600" as="sourcePoint" /><mxPoint x="415.0" y="600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-43" value="10. SET sid → {access, refresh, id, exp}" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.4444;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4444;entryDx=0;entryDy=0;" source="seq-28" target="seq-29"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="640" as="sourcePoint" /><mxPoint x="695.0" y="640" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-44" value="11. 302 / + Set-Cookie: sid=&amp;lt;256-bit random&amp;gt;;&lt;br&gt;HttpOnly; Secure; SameSite=Strict" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;exitX=0.5;exitY=0.4762;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4762;entryDx=0;entryDy=0;" source="seq-28" target="seq-27"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="680" as="sourcePoint" /><mxPoint x="135.0" y="680" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-45" value="12. GET /api/reports (Cookie: sid, X-CSRF-Token)" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.5317;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5317;entryDx=0;entryDy=0;" source="seq-27" target="seq-28"><mxGeometry relative="1" as="geometry"><mxPoint x="135.0" y="750" as="sourcePoint" /><mxPoint x="415.0" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-46" value="13. GET sid → токены" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.5635;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5635;entryDx=0;entryDy=0;" source="seq-28" target="seq-29"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="790" as="sourcePoint" /><mxPoint x="695.0" y="790" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-47" value="access истёк? → шаги 14–15, иначе сразу 16" vertex="1" parent="1" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#333333;"><mxGeometry x="330" y="805" width="300" height="30" as="geometry" /></mxCell><mxCell id="seq-48" value="14. POST /token: grant_type=refresh_token" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSize=10;align=center;spacingBottom=2;exitX=0.5;exitY=0.6190;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6190;entryDx=0;entryDy=0;" source="seq-28" target="seq-30"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="860" as="sourcePoint" /><mxPoint x="975.0" y="860" as="targetPoint" /></mxGeometry></mxCell><mxCell id="seq-49" value="15. новая пара access / refresh (ротация, старый refresh отозван)" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;curved=0;rounded=0;fontSiz