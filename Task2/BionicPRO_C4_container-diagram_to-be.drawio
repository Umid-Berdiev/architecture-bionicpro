;fontColor=#B85450;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="task1-3" target="task1-6"><mxGeometry width="160" relative="1" x="0.55" as="geometry"><Array as="points"><mxPoint x="1100" y="632" /></Array></mxGeometry></mxCell></object><object placeholders="1" id="task1-21" c4Type="Relationship" c4Technology="OIDC" c4Description="SSO покупателей и сотрудников" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;strokeColor=#B85450;fontColor=#B85450;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="-s9W17W-NFw-Ta7AQgpa-19" target="task1-3"><mxGeometry width="160" relative="1" x="0.3" as="geometry" /></mxCell></object><object placeholders="1" id="task1-22" c4Type="Relationship" c4Technology="OIDC" c4Description="SSO сотрудников" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;strokeColor=#B85450;fontColor=#B85450;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="-s9W17W-NFw-Ta7AQgpa-16" target="task1-3"><mxGeometry width="160" relative="1" x="0.3" as="geometry" /></mxCell></object><mxCell id="task1-23" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color='#B85450'&gt;——&amp;gt;&lt;/font&gt; связи, добавленные в to-be (задание 1 и 2)&lt;br&gt;&lt;font color='#2E7D32'&gt;- - -&amp;gt;&lt;/font&gt; пакетное перемещение данных (ETL)&lt;br&gt;——&amp;gt; связи из as-is; серый блок — внешняя система&lt;br&gt;&lt;br&gt;&lt;b&gt;Ключевые решения&lt;/b&gt;&lt;br&gt;1. Контур доступа на страну: Keycloak, BFF, Redis и БД — в стране, учётные данные из местного каталога.&lt;br&gt;2. Токены IdP не покидают сервер: клиенту — только session id (BFF).&lt;br&gt;3. Новые страны и IdP — через Identity Brokering, без изменения приложений.&lt;br&gt;4. Отчёты читаются из готовой витрины в ClickHouse, а не считаются на лету; витрину раз в час собирает Airflow из CRM и телеметрии.&lt;br&gt;5. API отдаёт только данные владельца токена и только за период до processed_until." vertex="1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;"><mxGeometry x="1660" y="1060" width="440" height="250" as="geometry" /></mxCell><object placeholders="1" id="task2-1" c4Name="Airflow (ETL)" c4Type="Container" c4Technology="Apache Airflow, DAG bionicpro_reports_etl" c4Description="Раз в час (@hourly): полная загрузка клиентов и протезов из CRM, инкрементальная загрузка телеметрии, пересборка витрины за затронутые дни, публикация processed_until. Метаданные — в своей PostgreSQL" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,